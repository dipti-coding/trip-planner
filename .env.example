POSTGRES_USER=trip_planner
POSTGRES_PASSWORD=secret
POSTGRES_DB=trip_planner_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trip_planner:secret@localhost:5432/trip_planner_dev
API_PORT=8000

# Auth — generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# Generate AUTH_USER_PASSWORD_HASH with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
JWT_SECRET_KEY=replace-with-a-random-hex-string
JWT_EXPIRE_MINUTES=60
AUTH_USER_EMAIL=you@example.com
AUTH_USER_PASSWORD_HASH='replace-with-bcrypt-hash'
AUTH_USER_PWD=yourpassword

# Sign in with Apple — set to your iOS app bundle ID (e.g. com.example.wandur)
APPLE_APP_BUNDLE_ID=com.example.wandur
# Set to 1 to enable the dev-only POST /auth/token endpoint. Never set in production.
AUTH_DEV_MODE=1

# Set to 1 to allow parsed dates outside the trip range during testing.
# Logs the original parsed date and substitutes the trip start date instead.
PARSE_TEST_MODE=0
